# ==============================================================================
# CONFIGURATION TAYLAXIS — EXEMPLE DE FICHIER ENVIRONMENT (.env.example)
# ==============================================================================

# 1. BASE DE DONNÉES & AUTHENTIFICATION (SUPABASE)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique-ici
SUPABASE_SERVICE_ROLE_KEY=votre-cle-secret-service-role-ici

# 2. PASSERELLES DE PAIEMENT EN LIGNE & MOBILE MONEY (FCFA / XOF)
# 💳 FEDAPAY (TMoney Togo, Flooz, MTN MoMo, Wave, Carte)
VITE_FEDAPAY_PUBLIC_KEY=pk_live_votre_cle_publique_fedapay
FEDAPAY_SECRET_KEY=sk_live_votre_cle_secrete_fedapay

# 💳 CINETPAY (Togo, Bénin, Côte d'Ivoire, Sénégal, Cameroun)
VITE_CINETPAY_SITE_ID=votre_site_id_cinetpay
VITE_CINETPAY_API_KEY=votre_api_key_cinetpay

# 💳 PAYSTACK
VITE_PAYSTACK_PUBLIC_KEY=pk_live_votre_cle_paystack
PAYSTACK_SECRET_KEY=sk_live_votre_cle_secrete_paystack

# 💳 STRIPE
VITE_STRIPE_PUBLIC_KEY=pk_live_votre_cle_stripe
STRIPE_SECRET_KEY=sk_live_votre_cle_secrete_stripe
